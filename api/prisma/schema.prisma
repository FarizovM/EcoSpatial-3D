generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Дозволяє Prisma працювати з розширеннями БД
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis] // Вказуємо, що використовуємо PostGIS
}

model Sensor {
  sensor_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text

  // Prisma не має нативного типу для PostGIS, тому використовуємо Unsupported
  geom Unsupported("geometry(Point, 4326)")

  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz()

  measurements AirQualityMeasurement[]

  // Додаємо просторовий індекс (GiST)
  @@index([geom], name: "idx_sensors_geom", type: Gist)
  @@map("sensors")
}

model AirQualityMeasurement {
  aqm_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sensor_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz()

  pm2_5       Decimal? @db.Decimal(5, 2)
  pm10        Decimal? @db.Decimal(5, 2)
  co2         Decimal? @db.Decimal(6, 2)
  temperature Decimal? @db.Decimal(5, 2)
  humidity    Decimal? @db.Decimal(5, 2)

  // Зв'язок таблиць
  sensor Sensor @relation(fields: [sensor_id], references: [sensor_id], onDelete: Restrict)

  // Композитний індекс
  @@index([sensor_id, created_at], name: "idx_measurements_sensor_time")
  @@map("air_quality_measurements")
}
